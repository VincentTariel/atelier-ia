# Atelier IA — variables d'environnement
# Copier en `.env` (à la racine du projet) et remplir avec les vraies valeurs.
# `.env` est gitignored — ne JAMAIS le committer.

# ==============================================================================
# DJANGO — sécurité
# ==============================================================================

# Clé secrète Django : générer une clé unique pour la prod
# Générer une nouvelle clé : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=changeme-generate-with-get_random_secret_key

# Mode debug : True en local, False en prod
DJANGO_DEBUG=True

# Hôtes autorisés (liste séparée par des virgules, sans schéma http://)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Exemple prod :
# DJANGO_ALLOWED_HOSTS=atelier-ia.ovh,www.atelier-ia.ovh,51.161.32.145

# ==============================================================================
# EMAIL — SMTP Gmail (envoi du PDF lead-magnet)
# ==============================================================================

# Compte expéditeur Gmail
EMAIL_HOST_USER=

# Mot de passe d'application Gmail (16 caractères, sans espaces)
# Générer : https://myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=

# Adresse "From" affichée dans les emails (souvent = EMAIL_HOST_USER)
DEFAULT_FROM_EMAIL=

# ==============================================================================
# ELEVENLABS — voix off vidéo (production finale, non utilisée par Django)
# ==============================================================================

# Clé API ElevenLabs (récupérer sur https://elevenlabs.io/app/settings/api-keys)
# Utilisée par video/scripts/generate_voiceover_elevenlabs.py
ELEVENLABS_API_KEY=
